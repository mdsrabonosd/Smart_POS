@model IEnumerable<SmartPOS.Models.Product>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Products";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Product Inventory</h4>
            <small class="text-muted">Manage your stock, pricing, and product categories</small>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-medium shadow-sm">
            <i class="fa-solid fa-plus me-2"></i>Add New Product
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="text-secondary fw-semibold">
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock Qty</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-box-open fs-2 mb-2 d-block"></i>
                            No products found. Let's add some inventory!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.Name</td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@item.Category?.Name</span>
                            </td>
                            <td class="fw-medium text-success">$@item.Price</td>
                            <td class="fw-medium">@item.StockQuantity Pcs</td>
                            <td>
                                @if (item.StockQuantity <= 5)
                                {
                                    <span class="badge bg-danger px-2 py-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-2 py-1"><i class="fa-solid fa-check me-1"></i>In Stock</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="fa-solid fa-pencil"></i>
                                    </a>


<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
    <i class="fa-solid fa-trash"></i>
</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@model SmartPOS.Models.Product

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <div class="mb-3 text-danger">
                <i class="fa-solid fa-circle-exclamation fs-1 animate__animated animate__pulse animate__infinite"></i>
            </div>
            
            <h4 class="fw-bold text-dark mb-2">Are you absolutely sure?</h4>
            <p class="text-muted small mb-4">You are about to permanently delete this product from the inventory. This action cannot be undone.</p>

            <div class="bg-light rounded-3 p-3 mb-4 text-start border">
                <div class="mb-2">
                    <small class="text-secondary d-block fw-semibold">Product Name</small>
                    <span class="text-dark fw-bold">@Model.Name</span>
                </div>
                <div class="row">
                    <div class="col-6 mb-2">
                        <small class="text-secondary d-block fw-semibold">Category</small>
                        <span class="badge bg-white text-dark border px-2 py-1 mt-1">@Model.Category?.Name</span>
                    </div>
                    <div class="col-6 mb-2">
                        <small class="text-secondary d-block fw-semibold">Current Stock</small>
                        <span class="text-dark fw-bold">@Model.StockQuantity Pcs</span>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-3 fw-medium">
                        Cancel, Keep It
                    </a>
                    <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-medium shadow-sm">
                        <i class="fa-solid fa-trash-can me-2"></i>Yes, Delete Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@model SmartPOS.Models.Sale

@{
    Layout = null; // আমরা কোনো অ্যাডমিন লেআউট বা সাইডবার এখানে দেখাবো না, শুধু ক্যাশ রিসিট দেখাবো
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - @Model.InvoiceNumber</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <style>
        /* থার্মাল প্রিন্টারের পেপার সাইজ (58mm/80mm) সিমুলেট করার জন্য কাস্টম সিএসএস */
        .ticket {
            width: 80mm;
            max-width: 80mm;
            margin: 20px auto;
            padding: 5px;
            font-family: 'Courier New', Courier, monospace; /* রসিদের ট্র্যাডিশনাল ফন্ট */
        }
        td, th, tr, table {
            border-top: 1px dashed black;
            border-collapse: collapse;
            font-size: 13px;
        }
        th { text-align: left; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }

        /* প্রিন্ট করার সময় প্রিন্ট বাটনটি লুকিয়ে ফেলার ম্যাজিক */
        @@media print {
            .no-print {
                display: none;
            }
            .ticket {
                margin: 0;
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- অ্যাকশন বাটন প্যানেল (প্রিন্ট করার সময় এটি দেখা যাবে না) -->
    <div class="text-center mt-3 no-print">
        <button onclick="window.print();" class="btn btn-success me-2">
            <i class="fa-solid fa-print"></i> Print Invoice
        </button>
        <a href="/Sales/Create" class="btn btn-primary">New Sale (POS)</a>
    </div>

    <!-- রসিদের মূল বডি -->
    <div class="ticket bg-white p-3 border shadow-sm">
        <div class="text-center">
            <h4 class="fw-bold mb-1">SMART POS</h4>
            <p class="small text-muted mb-2">Dhaka, Bangladesh<br>Tel: +880123456789</p>
        </div>

        <p class="small">
            <strong>Invoice:</strong> @Model.InvoiceNumber<br>
            <strong>Date:</strong> @Model.SaleDate.ToString("dd-MMM-yyyy hh:mm tt")<br>
            <strong>Customer:</strong> @Model.CustomerName
        </p>

        <table class="w-100">
            <thead>
                <tr>
                    <th class="py-1">Item</th>
                    <th class="text-center">Qty</th>
                    <th class="text-right">Price</th>
                    <th class="text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SaleDetails)
                {
                    <tr>
                        <td class="py-1">@item.Product?.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-right">@item.UnitPrice.ToString("0.00")</td>
                        <td class="text-right">@item.TotalPrice.ToString("0.00")</td>
                    </tr>
                }
                
                <!-- ফাইনাল হিসাব-নিকাশ সেকশন -->
                <tr>
                    <td colspan="3" class="text-right py-1"><strong>Sub Total:</strong></td>
                    <td class="text-right">@Model.TotalAmount.ToString("0.00")</td>
                </tr>
                <tr>
                    <td colspan="3" class="text-right py-1"><strong>Tax/Vat:</strong></td>
                    <td class="text-right">@Model.Tax.ToString("0.00")</td>
                </tr>
                <tr style="border-top: 2px solid black;">
                    <td colspan="3" class="text-right py-1"><h5><strong>Grand Total:</strong></h5></td>
                    <td class="text-right"><h5><strong>@Model.GrandTotal.ToString("0.00")</strong></h5></td>
                </tr>
            </tbody>
        </table>

        <div class="text-center mt-4 pt-3" style="border-top: 1px dashed black;">
            <p class="small fw-bold">Thank You For Shopping With Us!</p>
            <small class="text-muted" style="font-size: 10px;">Powered by SmartPOS</small>
        </div>
    </div>

</body>
</html>